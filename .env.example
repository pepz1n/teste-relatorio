# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendas
DB_USER=postgres
DB_PASSWORD=

# LM Studio — habilite o servidor local em: Local Server > Start Server
# O nome do modelo é exibido no canto superior esquerdo do LM Studio
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=defog/sqlcoder-7b-2   # ajuste para o nome exato exibido no LM Studio
LM_STUDIO_API_KEY=lm-studio           # qualquer valor, LM Studio não valida

# Servidor
PORT=3000
