# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendas
DB_USER=postgres
DB_PASSWORD=

# LM Studio — habilite o servidor local em: Local Server > Start Server
LM_STUDIO_URL=http://localhost:1234
# Nome exato do modelo carregado no LM Studio (exibido no canto superior esquerdo)
LM_STUDIO_MODEL=defog/sqlcoder-7b-2
# Qualquer valor serve, o LM Studio não valida a chave
LM_STUDIO_API_KEY=lm-studio
# Modo de geração:
#   completion — /v1/completions  → ideal para SQLCoder e modelos base
#   chat       — /v1/chat/completions → ideal para Mistral, Llama, Phi, Gemma, etc.
LM_STUDIO_MODE=completion

# Servidor
PORT=3000
